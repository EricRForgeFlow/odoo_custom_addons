; Copy to odoo.conf (git-ignored) and adjust paths/credentials to your machine:
;   cp odoo.conf.example odoo.conf
[options]
addons_path = /path/to/odoo/addons,/path/to/enterprise,/path/to/odoo_custom_addons
data_dir = /path/to/odoo_custom_addons/.filestore
admin_passwd = admin
; Uses the local PostgreSQL socket and your OS user by default; set db_host, db_port, db_user, db_password if needed

; Limit the database list to one database while developing (optional)
; dbfilter = ^mydb$

http_port = 8069
gevent_port = 8072
workers = 0
max_cron_threads = 1
with_demo = False
log_level = info

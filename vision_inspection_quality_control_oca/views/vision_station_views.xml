<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vision_station_view_form" model="ir.ui.view">
        <field name="name">vision.station.form - vision_inspection_quality_control_oca</field>
        <field name="model">vision.station</field>
        <field name="inherit_id" ref="vision_inspection.vision_station_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='verdict']" position="after">
                <group name="quality_control" string="Quality Control">
                    <field name="qc_test_id"/>
                    <field name="qc_trigger" invisible="not qc_test_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vision_inspection_view_form" model="ir.ui.view">
        <field name="name">vision.inspection.form - vision_inspection_quality_control_oca</field>
        <field name="model">vision.inspection</field>
        <field name="inherit_id" ref="vision_inspection.vision_inspection_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qc_inspections" type="object" class="oe_stat_button" icon="verified"
                        invisible="not qc_inspection_count" groups="quality_control_oca.group_quality_control_user">
                    <field name="qc_inspection_count" widget="statinfo" string="Quality"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

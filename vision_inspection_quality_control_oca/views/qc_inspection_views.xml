<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_inspection_form_view" model="ir.ui.view">
        <field name="name">qc.inspection.form - vision_inspection_quality_control_oca</field>
        <field name="model">qc.inspection</field>
        <field name="inherit_id" ref="quality_control_oca.qc_inspection_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_vision_inspection" type="object" class="oe_stat_button" icon="photo_camera"
                        string="Vision Inspection" invisible="not vision_inspection_id"
                        groups="vision_inspection.group_vision_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="vision_inspection_id" invisible="1" groups="vision_inspection.group_vision_user"/>
                <field name="vision_image" widget="image" class="oe_avatar" invisible="not vision_image"
                       options="{'zoom': true}"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="web_tour_tour_view_kanban" model="ir.ui.view">
        <field name="name">web_tour.tour.view.kanban.tour_manager</field>
        <field name="model">web_tour.tour</field>
        <field name="arch" type="xml">
            <kanban js_class="tour_manager_kanban" on_create="tour_manager.tour_create_wizard_action" edit="0" can_open="0" group_create="0" group_edit="0" group_delete="0" records_draggable="0">
                <field name="id"/>
                <field name="icon"/>
                <field name="custom"/>
                <field name="module_icon"/>
                <field name="is_done"/>
                <field name="check_state"/>
                <field name="check_message"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div t-attf-class="d-flex flex-row align-items-center gap-3 p-3 w-100 h-100 rounded #{record.custom.raw_value ? 'bg-info-subtle' : ''} #{record.id.raw_value === context.tour_manager_highlight_id ? 'border border-2 border-primary o_tour_manager_highlight' : ''}">
                            <t t-set="icon" t-value="record.icon.raw_value"/>
                            <i t-if="icon and icon.startsWith('oi:')" class="oi text-info o_tour_manager_icon" style="font-size: 3rem;"
                               t-att-data-icon="icon.slice(3)"/>
                            <img t-elif="icon" t-att-src="icon" class="o_image_64_contain o_tour_manager_icon" alt="Icon"/>
                            <img t-elif="record.module_icon.raw_value" t-att-src="record.module_icon.raw_value"
                                 class="o_image_64_contain" alt="App icon"/>
                            <i t-elif="record.custom.raw_value" class="oi text-info" style="font-size: 3rem;" data-icon="signpost" title="Custom tour"/>
                            <div class="flex-grow-1">
                                <t t-if="record.custom.raw_value">
                                    <field name="display_name" class="fw-bold fs-5"/>
                                    <div><span class="badge text-bg-info">Custom</span></div>
                                </t>
                                <t t-else="">
                                    <field name="module_name" class="fw-bold fs-5"/>
                                    <div class="text-muted"><field name="display_name"/></div>
                                </t>
                                <span t-if="record.is_done.raw_value" class="badge text-bg-success">Done</span>
                                <span t-if="record.check_state.raw_value === 'failed'" class="badge text-bg-danger ms-1 o_tour_manager_check_failed"
                                      t-att-title="record.check_message.raw_value">Check failed</span>
                                <span t-elif="record.check_state.raw_value === 'passed'" class="badge border border-success text-success ms-1 o_tour_manager_check_passed"
                                      t-att-title="record.check_message.raw_value">
                                    <i class="oi" data-icon="check_circle"/> Checked
                                </span>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <button name="action_start_tour" type="object" class="btn btn-primary">Start</button>
                                <button name="action_edit_tour" type="object" class="btn btn-secondary"
                                        invisible="not custom" groups="base.group_system">Edit</button>
                                <button name="action_check_tour" type="object" class="btn btn-link btn-sm p-0"
                                        groups="base.group_system" confirm="Checking the tour performs all its steps for real, e.g. creating or changing records. Check it?"
                                        title="Play the tour automatically, to check that all its steps still work">Check</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="web_tour_tour_view_list" model="ir.ui.view">
        <field name="name">web_tour.tour.view.list.tour_manager</field>
        <field name="model">web_tour.tour</field>
        <field name="arch" type="xml">
            <list js_class="tour_manager_list" create="0" edit="0" default_order="custom, module_name, sequence, name" decoration-info="custom">
                <field name="custom" column_invisible="1"/>
                <field name="module_name"/>
                <field name="display_name" string="Tour"/>
                <field name="url" optional="hide"/>
                <field name="is_done"/>
                <field name="check_state" optional="show" decoration-danger="check_state == 'failed'" decoration-success="check_state == 'passed'" widget="badge"/>
                <field name="check_date" optional="hide"/>
                <button name="action_start_tour" type="object" string="Start" class="btn-link" icon="play_arrow"/>
                <button name="action_check_tour" type="object" string="Check" class="btn-link" icon="check_circle"
                        groups="base.group_system" confirm="Checking the tour performs all its steps for real, e.g. creating or changing records. Check it?"/>
                <button name="action_edit_tour" type="object" string="Edit" class="btn-link" icon="edit"
                        invisible="not custom" groups="base.group_system"/>
            </list>
        </field>
    </record>

    <record id="web_tour_tour_view_form" model="ir.ui.view">
        <field name="name">web_tour.tour.view.form.tour_manager</field>
        <field name="model">web_tour.tour</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_start_tour" type="object" string="Start" class="btn-primary"/>
                    <button name="action_check_tour" type="object" string="Check" confirm="Checking the tour performs all its steps for real, e.g. creating or changing records. Check it?"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Create your first quotation"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Technical Name"/>
                            <field name="url"/>
                            <field name="icon" widget="tour_manager_icon_picker"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="custom" invisible="1"/>
                        </group>
                    </group>
                    <group name="check" string="Last Check" invisible="not check_state">
                        <field name="check_state" widget="badge" decoration-danger="check_state == 'failed'" decoration-success="check_state == 'passed'"/>
                        <field name="check_date"/>
                        <field name="check_message" class="text-break"/>
                    </group>
                    <notebook>
                        <page name="steps" string="Steps">
                            <field name="step_ids">
                                <list editable="bottom" decoration-danger="check_failed">
                                    <field name="check_failed" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="trigger"/>
                                    <field name="run"/>
                                    <field name="tooltip_position"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                        <page name="rainbow_man" string="Completion Message">
                            <field name="rainbow_man_message" placeholder="Message shown when the tour is completed..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="web_tour_tour_view_search" model="ir.ui.view">
        <field name="name">web_tour.tour.view.search.tour_manager</field>
        <field name="model">web_tour.tour</field>
        <field name="arch" type="xml">
            <search string="Tours">
                <field name="name" filter_domain="['|', ('title', 'ilike', self), ('name', 'ilike', self)]"/>
                <field name="module_name"/>
                <filter string="Onboarding" name="onboarding" domain="[('custom', '=', False)]"/>
                <filter string="Custom" name="custom" domain="[('custom', '=', True)]"/>
                <group>
                    <filter string="App" name="group_by_module_name" context="{'group_by': 'module_name'}"/>
                    <filter string="Type" name="group_by_custom" context="{'group_by': 'custom'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="web_tour_tour_action" model="ir.actions.act_window">
        <field name="name">Tours</field>
        <field name="res_model">web_tour.tour</field>
        <field name="path">tour_manager</field>
        <field name="view_mode">kanban,list</field>
        <field name="domain" eval="False"/>
        <field name="search_view_id" ref="web_tour_tour_view_search"/>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('web_tour_tour_view_kanban')}),
            Command.create({'view_mode': 'list', 'view_id': ref('web_tour_tour_view_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tours available</p>
            <p>Install apps that provide onboarding tours, or record your own tours, to see them here.</p>
        </field>
    </record>
</odoo>

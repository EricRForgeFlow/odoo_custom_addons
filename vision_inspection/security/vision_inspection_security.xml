<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_vision_inspection" model="res.groups.privilege">
        <field name="name">Vision Inspection</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_vision_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_vision_inspection"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">The user sees the inspections and can change their verdict. Sources run as a user of this group.</field>
    </record>

    <record id="group_vision_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_vision_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_vision_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">The user configures the sources, stations and defect classes.</field>
    </record>
</odoo>

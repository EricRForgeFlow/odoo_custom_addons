<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vision_station_view_list" model="ir.ui.view">
        <field name="name">vision.station.list</field>
        <field name="model">vision.station</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="source_id"/>
                <field name="product_id"/>
                <field name="verdict_mode"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="vision_station_view_form" model="ir.ui.view">
        <field name="name">vision.station.form</field>
        <field name="model">vision.station</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections" type="object" class="oe_stat_button" icon="photo_camera">
                            <field name="inspection_count" widget="statinfo" string="Inspections"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Line 1 - Camera A"/></h1>
                    </div>
                    <group>
                        <group name="station">
                            <field name="code"/>
                            <field name="source_id"/>
                            <field name="product_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="verdict" string="Verdict">
                            <field name="verdict_mode"/>
                            <field name="min_confidence"/>
                            <field name="review_confidence" invisible="verdict_mode != 'odoo'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vision_station_view_search" model="ir.ui.view">
        <field name="name">vision.station.search</field>
        <field name="model">vision.station</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="source_id"/>
                <field name="product_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/>
            </search>
        </field>
    </record>

    <record id="vision_station_action" model="ir.actions.act_window">
        <field name="name">Stations</field>
        <field name="res_model">vision.station</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vision_inspection_view_list" model="ir.ui.view">
        <field name="name">vision.inspection.list</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="verdict == 'fail'" decoration-warning="verdict == 'review'">
                <field name="name"/>
                <field name="captured_at"/>
                <field name="station_id"/>
                <field name="product_id"/>
                <field name="lot_name" optional="hide"/>
                <field name="model_name" optional="hide"/>
                <field name="defect_count" sum="Defects"/>
                <field name="verdict" widget="badge"
                       decoration-success="verdict == 'pass'" decoration-warning="verdict == 'review'" decoration-danger="verdict == 'fail'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="vision_inspection_view_kanban" model="ir.ui.view">
        <field name="name">vision.inspection.kanban</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <kanban create="0" sample="1">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_256" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold"/>
                            <field name="product_id"/>
                            <field name="station_id" class="text-muted"/>
                            <field name="captured_at" class="small"/>
                            <footer>
                                <span t-if="record.defect_count.raw_value === 0">No defects</span>
                                <span t-elif="record.defect_count.raw_value === 1">1 defect</span>
                                <span t-else=""><field name="defect_count"/> defects</span>
                                <field name="verdict" widget="badge" class="ms-auto"
                                       decoration-success="verdict == 'pass'" decoration-warning="verdict == 'review'" decoration-danger="verdict == 'fail'"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vision_inspection_view_form" model="ir.ui.view">
        <field name="name">vision.inspection.form</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_mark_pass" type="object" string="Mark as Pass" class="btn-primary"
                            invisible="verdict == 'pass'"/>
                    <button name="action_mark_fail" type="object" string="Mark as Fail"
                            invisible="verdict == 'fail'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Pass" bg_color="text-bg-success" invisible="verdict != 'pass'"/>
                    <widget name="web_ribbon" title="To Review" bg_color="text-bg-warning" invisible="verdict != 'review'"/>
                    <widget name="web_ribbon" title="Fail" bg_color="text-bg-danger" invisible="verdict != 'fail'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="station_id" readonly="1"/>
                            <field name="source_id"/>
                            <field name="captured_at" readonly="1"/>
                            <field name="external_id"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="lot_name"/>
                            <field name="defect_count"/>
                            <field name="verdict" invisible="1"/>
                            <field name="verdict_origin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Image" name="image">
                            <field name="image" widget="vision_image_annotations" readonly="1" nolabel="1"
                                   options="{'detections_field': 'detection_ids'}"/>
                        </page>
                        <page string="Detections" name="detections">
                            <field name="detection_ids" readonly="1">
                                <list decoration-muted="not counted">
                                    <field name="defect_class_id"/>
                                    <field name="label" optional="hide"/>
                                    <field name="severity" widget="badge"
                                           decoration-warning="severity == 'major'" decoration-danger="severity == 'critical'"/>
                                    <field name="confidence"/>
                                    <field name="counted"/>
                                    <field name="bbox_x" optional="hide"/>
                                    <field name="bbox_y" optional="hide"/>
                                    <field name="bbox_w" optional="hide"/>
                                    <field name="bbox_h" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Model" name="model">
                            <group>
                                <field name="model_name"/>
                                <field name="model_version"/>
                                <field name="raw_payload" groups="base.group_no_one"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vision_inspection_view_pivot" model="ir.ui.view">
        <field name="name">vision.inspection.pivot</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <pivot string="Inspections" sample="1">
                <field name="product_id" type="row"/>
                <field name="verdict" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="vision_inspection_view_graph" model="ir.ui.view">
        <field name="name">vision.inspection.graph</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <graph string="Inspections" type="bar" stacked="1" sample="1">
                <field name="captured_at" interval="day"/>
                <field name="verdict"/>
            </graph>
        </field>
    </record>

    <record id="vision_inspection_view_search" model="ir.ui.view">
        <field name="name">vision.inspection.search</field>
        <field name="model">vision.inspection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_name"/>
                <field name="station_id"/>
                <field name="source_id"/>
                <field name="detection_ids" string="Defect Class" filter_domain="[('detection_ids.defect_class_id', 'ilike', self)]"/>
                <filter name="pass" string="Pass" domain="[('verdict', '=', 'pass')]"/>
                <filter name="review" string="To Review" domain="[('verdict', '=', 'review')]"/>
                <filter name="fail" string="Fail" domain="[('verdict', '=', 'fail')]"/>
                <separator/>
                <filter name="critical" string="Critical Defects"
                        domain="[('detection_ids', 'any', [('counted', '=', True), ('severity', '=', 'critical')])]"/>
                <filter name="manual" string="Changed Manually" domain="[('verdict_origin', '=', 'manual')]"/>
                <separator/>
                <filter name="captured_at" string="Captured On" date="captured_at"/>
                <filter name="group_verdict" string="Verdict" context="{'group_by': 'verdict'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_station" string="Station" context="{'group_by': 'station_id'}"/>
                <filter name="group_captured_at" string="Day" context="{'group_by': 'captured_at:day'}"/>
            </search>
        </field>
    </record>

    <record id="vision_inspection_action" model="ir.actions.act_window">
        <field name="name">Inspections</field>
        <field name="res_model">vision.inspection</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No inspection received yet</p>
            <p>Inspections appear here as soon as a vision source sends its results.</p>
        </field>
    </record>

    <record id="vision_inspection_action_report" model="ir.actions.act_window">
        <field name="name">Inspections Analysis</field>
        <field name="res_model">vision.inspection</field>
        <field name="view_mode">graph,pivot,list,form</field>
    </record>
</odoo>

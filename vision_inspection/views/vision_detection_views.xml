<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vision_detection_view_list" model="ir.ui.view">
        <field name="name">vision.detection.list</field>
        <field name="model">vision.detection</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-muted="not counted">
                <field name="captured_at"/>
                <field name="inspection_id"/>
                <field name="station_id"/>
                <field name="product_id"/>
                <field name="defect_class_id"/>
                <field name="severity" widget="badge"
                       decoration-warning="severity == 'major'" decoration-danger="severity == 'critical'"/>
                <field name="confidence"/>
                <field name="counted"/>
            </list>
        </field>
    </record>

    <record id="vision_detection_view_pivot" model="ir.ui.view">
        <field name="name">vision.detection.pivot</field>
        <field name="model">vision.detection</field>
        <field name="arch" type="xml">
            <pivot string="Defects" sample="1">
                <field name="defect_class_id" type="row"/>
                <field name="captured_at" interval="day" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="vision_detection_view_graph" model="ir.ui.view">
        <field name="name">vision.detection.graph</field>
        <field name="model">vision.detection</field>
        <field name="arch" type="xml">
            <graph string="Defects" type="bar" stacked="1" sample="1">
                <field name="captured_at" interval="day"/>
                <field name="defect_class_id"/>
            </graph>
        </field>
    </record>

    <record id="vision_detection_view_search" model="ir.ui.view">
        <field name="name">vision.detection.search</field>
        <field name="model">vision.detection</field>
        <field name="arch" type="xml">
            <search>
                <field name="defect_class_id"/>
                <field name="inspection_id"/>
                <field name="product_id"/>
                <field name="station_id"/>
                <filter name="counted" string="Counted" domain="[('counted', '=', True)]"/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <separator/>
                <filter name="captured_at" string="Captured On" date="captured_at"/>
                <filter name="group_class" string="Class" context="{'group_by': 'defect_class_id'}"/>
                <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_station" string="Station" context="{'group_by': 'station_id'}"/>
            </search>
        </field>
    </record>

    <record id="vision_detection_action_report" model="ir.actions.act_window">
        <field name="name">Defects Analysis</field>
        <field name="res_model">vision.detection</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_counted': 1}</field>
    </record>
</odoo>
